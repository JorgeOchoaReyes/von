# Von — control plane environment.
#
# Copy to `.env` and fill in from the top. It is ordered by what unlocks what,
# not alphabetically: each stage is usable on its own, and the control plane
# starts at any of them and tells you what the missing ones cost.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#   pnpm --filter @von/api dev
#
# `GET /v1/readiness` returns the same checklist as JSON at any time, and the
# boot log prints it. Neither ever checks whether a credential is *valid* —
# proving that would mean spending money on every health check — so a
# syntactically perfect token the provider rejects still fails at the provider.
#
# Full instructions for obtaining each of these: docs/DEPLOY.md.


# ── Stage 1 — the product loop ────────────────────────────────────────────────
#
# Enough to describe an app in chat, watch a preview, and publish a change to a
# repository you already own. No billing account, no Expo org, no DNS.
#
# Create the app with `repoFullName` set and provisioning is skipped entirely.
# Publishing dispatches that repo's own workflows, so a repo without
# `eas-update.yml` and an `EXPO_TOKEN` fails inside its Actions — everything up
# to and including the commit and push is real.

ANTHROPIC_API_KEY=
GITHUB_INSTALLATION_TOKEN=


# ── Stage 2 — provisioning an app from nothing ────────────────────────────────
#
# Creating the app's repository, backend, and EAS project without an existing
# repo to adopt.

# The blueprint, pushed to its own repo and marked a template in its settings.
# Its default branch must be `master`: GitHub's template-generate copies the
# template's branch name, and the generated workflows trigger on `master`.
VON_GITHUB_ORG=
VON_TEMPLATE_REPO=

# Baked into every generated app as the address it fetches its backend config
# from at boot. A wrong value here is not a startup failure — it is an app on
# someone's phone that cannot reach its own backend.
VON_PUBLIC_URL=http://localhost:8787

# Google. Set exactly one of the first two; on Cloud Run set neither and the
# instance metadata server supplies the identity.
#
#   GOOGLE_SERVICE_ACCOUNT_KEY      the key file's JSON, inline
#   GOOGLE_APPLICATION_CREDENTIALS  a path to it
#   GOOGLE_ACCESS_TOKEN             `gcloud auth print-access-token`, for a
#                                   quick local try. It expires in about an
#                                   hour; a control plane left running past
#                                   that starts failing provisioning with 401s
#                                   while every variable still looks correct.
GOOGLE_SERVICE_ACCOUNT_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_ACCESS_TOKEN=

# The folder or organisation new pool projects are created under, and the
# billing account attached to them.
GCP_PARENT=folders/000000000000
GCP_BILLING_ACCOUNT=billingAccounts/000000-000000-000000
GCP_LOCATION=us-central1

# Pool projects, and each one's Firebase web config. A pooled app gets its own
# GCIP tenant and its own named Firestore database inside one of these.
#   VON_POOLS='["von-pool-001"]'
#   VON_POOL_WEB_CONFIGS='{"von-pool-001":{"apiKey":"…","authDomain":"…","projectId":"von-pool-001","storageBucket":"…","messagingSenderId":"…","appId":"…"}}'
VON_POOLS=[]
VON_POOL_WEB_CONFIGS={}

# Expo. EXPO_TOKEN is also written into each generated repo, which is how its
# workflows publish updates and builds.
EXPO_TOKEN=
EXPO_ACCOUNT_ID=
EXPO_ACCOUNT_NAME=

# Handed to each generated app's Cloud Functions.
GEMINI_API_KEY=


# ── Stage 3 — running it as a deployment ──────────────────────────────────────

# Durable storage. Without it apps, the resource ledger and pool assignments
# live in memory: they are lost on restart, and a re-run of provisioning
# creates duplicate cloud resources rather than resuming.
VON_FIRESTORE_PROJECT=
VON_FIRESTORE_DATABASE=von-control

# Comma-separated. **Not optional once deployed**: every endpoint here creates
# billable cloud resources, and the control plane refuses to start without this
# as soon as VON_FIRESTORE_PROJECT or VON_PREVIEW_HOST is set. An open control
# plane is someone else's free build farm.
VON_API_KEYS=

# Wildcard DNS pointed at the control plane, e.g. `preview.example.com` with
# `*.preview.example.com` resolving here. Each preview session is served at its
# own subdomain — an origin rather than a path prefix, because Metro serves
# root-absolute URLs no prefix rewrite survives. Unset, previews work only on
# the machine running the control plane.
VON_PREVIEW_HOST=


# ── Stage 4 — optional capabilities ───────────────────────────────────────────

# Where a promotion stages its Firestore export. Promotion works without it —
# the caller has to accept that the app starts against an empty database — but
# "your data comes with you" does not.
VON_MIGRATION_BUCKET=

# The platform's Google Play service account JSON, shared by every app it
# submits. Play still requires a listing created by hand with the app's package
# name, and one bundle uploaded through its console before it accepts any
# through the API.
GOOGLE_PLAY_SERVICE_ACCOUNT=
